# Masonic Lounge release environment template.
# Copy to .env and adjust values.

# PostgreSQL
POSTGRES_USER=masonic
POSTGRES_PASSWORD=masonic
POSTGRES_DB=masoniclounge

# MinIO / S3
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=masonic
S3_REGION=us-east-1

# API (JWT_SECRET MUST be >= 32 chars; generate with: openssl rand -hex 32)
JWT_SECRET=change-me-please-use-at-least-32-characters
JWT_ISSUER=masoniccore
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30
REFRESH_COOKIE_NAME=masonic_refresh
REFRESH_COOKIE_SECURE=true

# Web entrypoint on the host
WEB_PORT=8080